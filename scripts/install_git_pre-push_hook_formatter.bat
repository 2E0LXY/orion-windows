@echo off
setlocal

cd %~dp0..

echo Restoring dotnet tools...
dotnet tool restore
if %errorlevel% neq 0 (
    echo ERROR: dotnet tool restore failed
    exit /b %errorlevel%
)

echo.
echo Installing pre-push hook...

set HOOK_FILE=.git\hooks\pre-push

(
echo #!/bin/sh
echo.
echo # Formatting-check pre-push hook
echo # Auto-generated by install_git_pre-push_hook_formatter.bat
echo # Logic is in format.sh; stdin carries the refs being pushed.
echo.
echo exec ./format.sh --verify --filter-commits
) > %HOOK_FILE%

if %errorlevel% neq 0 (
    echo ERROR: Failed to create pre-push hook
    exit /b %errorlevel%
)

echo.
echo Pre-push hook installed successfully at %HOOK_FILE%
echo.
echo Before each push the hook verifies formatting of *.cs/*.xaml, but only
echo when the pushed commits actually touch formatting-relevant files.
echo If the check fails, run format.sh and commit the result.

exit /b 0
