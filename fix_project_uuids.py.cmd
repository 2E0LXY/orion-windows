'''
@echo off & cd %~dp0 & bin\\uv.exe run python "%~dpf0" %* & exit /b ::'''

"""Keep the CMake-generated core module vcxproj GUIDs equal to the ids in Orion.slnx.

CMake derives each project's GUID from the build directory path (UUIDv3 of
"<binary dir>|<target>"), so every checkout location and every developer gets
different GUIDs. If Visual Studio ever loads a vcxproj whose GUID differs from
the solution's <Project Id>, it "repairs" the solution by writing the project's
GUID into Orion.slnx -- the churn that keeps showing up in git status.

Two modes:

  --write-cmake-cache FILE   write a cmake initial-cache script (`cmake -C FILE`)
                             that seeds <target>_GUID_CMAKE for every core module
                             project listed in the solution. CMake reads these
                             cache entries before computing a GUID, so the vcxproj
                             files are generated with the solution's ids in the
                             first place. This is the primary mechanism.

  (no arguments)             fallback: rewrite <ProjectGuid> / <ProjectReference>
                             in the generated vcxproj files to match the solution,
                             and sweep tlog dirs left behind by an earlier GUID.
                             Prints "No changes needed" when seeding did its job.
"""

import shutil
import sys
import xml.etree.ElementTree as ET
from pathlib import Path
import re

# MSBuild namespace
NS = {"ms": "http://schemas.microsoft.com/developer/msbuild/2003"}

# Only the CMake-generated projects need seeding/fixing; the WebKit browsing
# projects under external/vcpkg are generated by update_wk_solution.py.cmd.
CORE_MODULE_PREFIX = "external/orion-gtk/"

def get_external_projects(slnx_path: Path) -> dict[str, str]:
    """Parse .slnx and return {path: id} for all projects under external/"""
    tree = ET.parse(slnx_path)
    root = tree.getroot()

    projects = {}
    for project in root.iter("Project"):
        path = project.get("Path", "")
        project_id = project.get("Id")
        if path.startswith("external/") and project_id:
            projects[path] = project_id.upper()

    return projects

def get_filename_to_id_map(projects: dict[str, str]) -> dict[str, str]:
    """Create {filename: id} mapping for ProjectReference lookups"""
    return {Path(path).name: project_id for path, project_id in projects.items()}

def fix_vcxproj(vcxproj_path: Path, project_id: str, filename_to_id: dict[str, str]) -> bool:
    """Fix ProjectGuid and ProjectReference elements in a vcxproj file"""

    # Register namespace to preserve it in output
    ET.register_namespace("", "http://schemas.microsoft.com/developer/msbuild/2003")

    tree = ET.parse(vcxproj_path)
    root = tree.getroot()
    modified = False

    # Fix ProjectGuid
    for prop_group in root.findall(".//ms:PropertyGroup[@Label='Globals']", NS):
        for guid_elem in prop_group.findall("ms:ProjectGuid", NS):
            new_guid = "{" + project_id + "}"
            if guid_elem.text != new_guid:
                guid_elem.text = new_guid
                modified = True

    # Fix ProjectReference elements
    for proj_ref in root.findall(".//ms:ProjectReference[@Include]", NS):
        include_path = proj_ref.get("Include", "")
        filename = Path(include_path).name

        if filename in filename_to_id:
            new_id = "{" + filename_to_id[filename] + "}"
            project_elem = proj_ref.find("ms:Project", NS)

            if project_elem is None:
                # Create <Project> element if it doesn't exist
                project_elem = ET.SubElement(proj_ref, "{http://schemas.microsoft.com/developer/msbuild/2003}Project")
                project_elem.text = new_id
                modified = True
            elif project_elem.text != new_id:
                project_elem.text = new_id
                modified = True

    if modified:
        # Write with XML declaration
        tree.write(vcxproj_path, encoding="utf-8", xml_declaration=True)

    return modified

def sweep_stale_tlogs(project_dirs: set[Path], valid_ids: set[str]) -> None:
    """Delete .tlog dirs named for a previous project GUID. Nothing else ever
    cleans them, and they trip MSB8028 and wedge the IDE up-to-date check
    (see docs_ai/msbuild_custom_build_steps.md)."""
    fragments = {pid[:8] for pid in valid_ids}
    guid_tlog = re.compile(r"[^.]+\.([0-9A-Fa-f]{8})\.tlog")
    seen = set()
    for root in project_dirs:
        for tlog_dir in root.rglob("*.tlog"):
            resolved = tlog_dir.resolve()
            if resolved in seen or not tlog_dir.is_dir():
                continue
            seen.add(resolved)
            m = guid_tlog.fullmatch(tlog_dir.name)
            if m and m.group(1).upper() not in fragments:
                shutil.rmtree(tlog_dir)
                print(f"Deleted stale tlog dir: {tlog_dir}")

def write_cmake_cache(projects: dict[str, str], out_path: Path) -> None:
    """Emit `set(<target>_GUID_CMAKE ...)` for each core module project. The
    vcxproj stem is the CMake target name (orion_core.vcxproj -> orion_core);
    cmGlobalVisualStudio7Generator::GetGUID returns a cached
    <target>_GUID_CMAKE verbatim instead of hashing the build dir."""
    lines = [
        "# Generated by fix_project_uuids.py.cmd from Orion.slnx -- do not edit.",
        "# Seeds the project GUIDs CMake writes into the generated vcxproj files so",
        "# they match the solution and Visual Studio never rewrites Orion.slnx.",
    ]
    for path, project_id in sorted(projects.items()):
        if not path.startswith(CORE_MODULE_PREFIX):
            continue
        target = Path(path).stem
        lines.append(f'set({target}_GUID_CMAKE "{project_id}" CACHE INTERNAL "project GUID from Orion.slnx")')
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"Wrote {out_path} ({len(lines) - 3} project GUIDs from Orion.slnx)")

if __name__ == "__main__":
    script_dir = Path(__file__).parent
    slnx_path = script_dir / "Orion.slnx"

    projects = get_external_projects(slnx_path)

    if len(sys.argv) == 3 and sys.argv[1] == "--write-cmake-cache":
        write_cmake_cache(projects, Path(sys.argv[2]))
        sys.exit(0)
    if len(sys.argv) != 1:
        sys.exit(f"usage: {Path(__file__).name} [--write-cmake-cache FILE]")

    filename_to_id = get_filename_to_id_map(projects)

    print(f"Fixing generated project UUIDs. Found {len(projects)} external projects in Orion.slnx")

    any_modified = False
    for path, project_id in projects.items():
        vcxproj_path = script_dir / path
        if not vcxproj_path.exists():
            continue

        if fix_vcxproj(vcxproj_path, project_id, filename_to_id):
            print(f"Modified: {path}")
            any_modified = True

    if not any_modified:
        print("No changes needed")

    project_dirs = {(script_dir / p).parent for p in projects if (script_dir / p).exists()}
    sweep_stale_tlogs(project_dirs, set(projects.values()))
