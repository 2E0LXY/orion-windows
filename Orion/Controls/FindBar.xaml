<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Orion.FindBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    SizeChanged="Host_SizeChanged">

    <!--  Unconstrained (windowed) popup renders above the native web HWND.  -->
    <primitives:Popup
        x:Name="CardPopup"
        IsLightDismissEnabled="False"
        ShouldConstrainToRootBounds="False">
        <Border
            x:Name="Card"
            Padding="6,4"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            SizeChanged="Card_SizeChanged">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBox
                    x:Name="QueryBox"
                    Width="180"
                    VerticalAlignment="Center"
                    KeyDown="QueryBox_KeyDown"
                    PlaceholderText="Find in page"
                    TextChanged="QueryBox_TextChanged" />
                <TextBlock
                    x:Name="ResultText"
                    MinWidth="56"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Right" />
                <Border
                    Width="1"
                    Margin="0,4"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button
                    x:Name="PreviousButton"
                    VerticalAlignment="Center"
                    Click="PreviousButton_Click"
                    ToolTipService.ToolTip="Previous match">
                    <FontIcon FontSize="12" Glyph="&#xE70E;" />
                </Button>
                <Button
                    x:Name="NextButton"
                    VerticalAlignment="Center"
                    Click="NextButton_Click"
                    ToolTipService.ToolTip="Next match">
                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                </Button>
                <Button
                    VerticalAlignment="Center"
                    Click="CloseButton_Click"
                    ToolTipService.ToolTip="Close">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </StackPanel>
        </Border>
    </primitives:Popup>
</UserControl>
