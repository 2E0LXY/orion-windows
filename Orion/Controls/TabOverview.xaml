<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Orion.TabOverview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Orion"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    SizeChanged="Host_SizeChanged">

    <!--
        Unconstrained (windowed) popup renders above the native web HWND,
        so the page stays visible (dimmed) behind the overview.
    -->
    <primitives:Popup
        x:Name="OverviewPopup"
        IsLightDismissEnabled="False"
        ShouldConstrainToRootBounds="False">
        <Grid
            x:Name="Scrim"
            Background="#80000000"
            KeyDown="Root_KeyDown"
            Tapped="Scrim_Tapped">
            <Grid
                x:Name="Card"
                Margin="48"
                Padding="12"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Tapped="Card_Tapped">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    Grid.Row="0"
                    MaxWidth="480"
                    Margin="12,4,12,12"
                    KeyDown="SearchBox_KeyDown"
                    PlaceholderText="Search tabs"
                    TextChanged="SearchBox_TextChanged" />

                <GridView
                    x:Name="TabGrid"
                    Grid.Row="1"
                    Padding="12"
                    HorizontalAlignment="Center"
                    IsItemClickEnabled="True"
                    ItemClick="TabGrid_ItemClick"
                    SelectionMode="None">
                    <GridView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="local:TabOverviewGroup">
                                    <TextBlock
                                        Margin="8,4"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </GridView.GroupStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:BrowserTab">
                            <Grid
                                Width="256"
                                Margin="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="144" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--
                                    Thumbnail, or a favicon placeholder card for
                                    tabs that have never been captured
                                -->
                                <Grid Grid.Row="0" CornerRadius="8,8,0,0">
                                    <FontIcon
                                        FontSize="28"
                                        Glyph="&#xE774;"
                                        Opacity="0.3"
                                        Visibility="{x:Bind local:TabOverview.VisibleIfNull(ThumbnailImage), Mode=OneWay}" />
                                    <Image
                                        Width="32"
                                        Height="32"
                                        Source="{x:Bind FaviconImage, Mode=OneWay}"
                                        Visibility="{x:Bind local:TabOverview.VisibleIfNull(ThumbnailImage), Mode=OneWay}" />
                                    <!--
                                        ImageBrush, not Image: Image's UniformToFill
                                        anchors the crop top-left; the brush can
                                        center it (captures are wider than 16:9)
                                    -->
                                    <Border Visibility="{x:Bind local:TabOverview.VisibleIfNotNull(ThumbnailImage), Mode=OneWay}">
                                        <Border.Background>
                                            <ImageBrush
                                                AlignmentX="Center"
                                                AlignmentY="Top"
                                                ImageSource="{x:Bind ThumbnailImage, Mode=OneWay}"
                                                Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <!--  Footer: favicon, title, close  -->
                                <Grid Grid.Row="1" Padding="10,6,4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                        Grid.Column="0"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Source="{x:Bind FaviconImage, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="2"
                                        Padding="6"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="CloseTab_Click"
                                        ToolTipService.ToolTip="Close tab">
                                        <FontIcon FontSize="10" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>
    </primitives:Popup>
</UserControl>
