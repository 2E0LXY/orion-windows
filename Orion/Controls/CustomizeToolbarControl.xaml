<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Orion.CustomizeToolbarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Orion"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    mc:Ignorable="d">

    <Border
        Width="780"
        Padding="24,20,24,20"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12">

        <StackPanel Spacing="12">

            <!--  Instruction text  -->
            <TextBlock
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Drag your favorite items into the toolbar..." />

            <!--  Available items palette  -->
            <GridView
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind AvailableItems}"
                SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            ItemHeight="84"
                            ItemWidth="100"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:ToolbarButtonItem">
                        <StackPanel
                            Width="96"
                            Height="80"
                            HorizontalAlignment="Center"
                            Spacing="6">
                            <Border
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                CornerRadius="8">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="20"
                                    Glyph="{x:Bind Glyph}" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Text="{x:Bind Label}"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!--  Default set instruction  -->
            <TextBlock
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="... or drag the default set into the toolbar." />

            <!--  Toolbar preview strip  -->
            <Border
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ToolbarPreviewItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ToolbarButtonItem">
                                <StackPanel
                                    Width="76"
                                    Padding="8,10"
                                    HorizontalAlignment="Center"
                                    Spacing="4">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="18"
                                        Glyph="{x:Bind Glyph}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Text="{x:Bind Label}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!--  Divider  -->
            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!--  Footer: Show dropdown (left) + Done button (right)  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <TextBlock VerticalAlignment="Center" Text="Show" />
                    <ComboBox MinWidth="130" SelectedIndex="0">
                        <ComboBoxItem Content="Icon Only" />
                        <ComboBoxItem Content="Icon and Text" />
                        <ComboBoxItem Content="Text Only" />
                    </ComboBox>
                </StackPanel>

                <Button
                    Grid.Column="2"
                    MinWidth="80"
                    Click="DoneButton_Click"
                    Content="Done"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
