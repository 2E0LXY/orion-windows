<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Orion.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Orion"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Orion"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Top Bar  -->
        <Grid Grid.Row="0" Padding="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Text="Downloads" />

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="1"
                MaxWidth="400"
                Margin="24,0"
                VerticalAlignment="Center"
                PlaceholderText="Search downloads..."
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />

            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="ClearAll_Click"
                Content="Clear All" />
        </Grid>

        <!--  Downloads List  -->
        <ListView
            x:Name="DownloadsListView"
            Grid.Row="1"
            Padding="24,0,24,24"
            SelectionMode="Single">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="local:DownloadGroup">
                            <TextBlock
                                Margin="0,8,0,4"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{x:Bind Key}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadEntry">
                    <Grid
                        Padding="4,10"
                        ColumnSpacing="12"
                        DoubleTapped="DownloadItem_DoubleTapped">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Click="OpenFile_Click"
                                    Tag="{x:Bind Id, Mode=OneWay}"
                                    Text="Open"
                                    Visibility="{x:Bind local:DownloadsPage.IsCompleted(Status), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8E5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="ShowInFolder_Click"
                                    Tag="{x:Bind Id, Mode=OneWay}"
                                    Text="Show in Folder"
                                    Visibility="{x:Bind local:DownloadsPage.IsCompleted(Status), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="Cancel_Click"
                                    Tag="{x:Bind Id, Mode=OneWay}"
                                    Text="Stop"
                                    Visibility="{x:Bind local:DownloadsPage.IsActiveDownload(Status), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE71A;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="Restart_Click"
                                    Tag="{x:Bind Id, Mode=OneWay}"
                                    Text="Restart"
                                    Visibility="{x:Bind local:DownloadsPage.IsRestartable(Status), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72C;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Click="CopyAddress_Click"
                                    Tag="{x:Bind Id, Mode=OneWay}"
                                    Text="Copy Address">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE71B;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="Remove_Click"
                                    Tag="{x:Bind Id, Mode=OneWay}"
                                    Text="Remove from List"
                                    Visibility="{x:Bind local:DownloadsPage.IsRemovable(Status), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Icon  -->
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE896;" />

                        <!--  File info  -->
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                FontSize="14"
                                Text="{x:Bind FileName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Url, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <!--  Progress bar for active downloads  -->
                            <ProgressBar
                                MaxWidth="300"
                                HorizontalAlignment="Left"
                                IsIndeterminate="{x:Bind local:DownloadsPage.IsIndeterminate(TotalBytes, Status), Mode=OneWay}"
                                Maximum="100"
                                Visibility="{x:Bind local:DownloadsPage.IsActiveDownload(Status), Mode=OneWay}"
                                Value="{x:Bind Progress, Mode=OneWay}" />
                        </StackPanel>

                        <!--  Size / Status  -->
                        <StackPanel
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind local:DownloadsPage.FormatDownloadSize(ReceivedBytes, TotalBytes, Status), Mode=OneWay}"
                                TextAlignment="Right" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind local:DownloadsPage.FormatStatus(Status, BytesPerSecond, ReceivedBytes, TotalBytes), Mode=OneWay}"
                                TextAlignment="Right" />
                        </StackPanel>

                        <!--  Action buttons  -->
                        <StackPanel
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="2">
                            <!--  Open File (completed only)  -->
                            <Button
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="OpenFile_Click"
                                Tag="{x:Bind Id, Mode=OneWay}"
                                ToolTipService.ToolTip="Open file"
                                Visibility="{x:Bind local:DownloadsPage.IsCompleted(Status), Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="&#xE8E5;" />
                            </Button>
                            <!--  Show in Folder (completed only)  -->
                            <Button
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="ShowInFolder_Click"
                                Tag="{x:Bind Id, Mode=OneWay}"
                                ToolTipService.ToolTip="Show in folder"
                                Visibility="{x:Bind local:DownloadsPage.IsCompleted(Status), Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="&#xE838;" />
                            </Button>
                            <!--  Cancel (downloading/paused only)  -->
                            <Button
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="Cancel_Click"
                                Tag="{x:Bind Id, Mode=OneWay}"
                                ToolTipService.ToolTip="Cancel"
                                Visibility="{x:Bind local:DownloadsPage.IsActiveDownload(Status), Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                            <!--  Restart (failed/cancelled only)  -->
                            <Button
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="Restart_Click"
                                Tag="{x:Bind Id, Mode=OneWay}"
                                ToolTipService.ToolTip="Restart"
                                Visibility="{x:Bind local:DownloadsPage.IsRestartable(Status), Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="&#xE72C;" />
                            </Button>
                        </StackPanel>

                        <!--  Remove  -->
                        <Button
                            Grid.Column="4"
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="Remove_Click"
                            Tag="{x:Bind Id, Mode=OneWay}"
                            ToolTipService.ToolTip="Remove from list">
                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Empty State  -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="48"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE896;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No downloads" />
        </StackPanel>
    </Grid>
</UserControl>
