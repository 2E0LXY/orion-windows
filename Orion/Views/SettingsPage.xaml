                                    Unchecked="AutocompleteHistory_Changed" />
                                <CheckBox
                                    x:Name="AutocompleteBookmarksCheckBox"
                                    Checked="AutocompleteBookmarks_Changed"
                                    Content="Bookmarks"
                                    IsChecked="True"
                                    Unchecked="AutocompleteBookmarks_Changed" />
                                <CheckBox
                                    x:Name="AutocompleteOpenTabsCheckBox"
                                    Checked="AutocompleteOpenTabs_Changed"
                                    Content="Open tabs"
                                    IsChecked="True"
                                    Unchecked="AutocompleteOpenTabs_Changed" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!--  Websites Content  -->
                <ScrollViewer x:Name="WebsitesContent" Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="600"
                        HorizontalAlignment="Center"
                        Spacing="16">
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="Websites" />
                    </StackPanel>
                </ScrollViewer>
                <Grid
                    x:Name="WebsitesGrid"
                    MaxWidth="800"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  General Settings List (Left)  -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,12"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="General Settings" />

                        <ListView
                            x:Name="WebsiteSettingsListView"
                            Grid.Row="1"
                            SelectionChanged="WebsiteSettingsListView_SelectionChanged">
                            <ListViewItem Content="Reader Mode" />
                            <ListViewItem Content="Auto-Play" />
                            <ListViewItem Content="Page Zoom" />
                            <ListViewItem Content="Pop-up Windows" />
                            <ListViewItem Content="Notifications" />
                            <ListViewItem Content="Downloads" />
                            <ListViewItem Content="Camera" />
                            <ListViewItem Content="Microphone" />
                            <ListViewItem Content="Screen Sharing" />
                            <ListViewItem Content="Location" />
                            <ListViewItem Content="Content Blockers" />
                            <ListViewItem Content="Tracking Prevention" />
                            <ListViewItem Content="Cookies" />
                            <ListViewItem Content="JavaScript" />
                            <ListViewItem Content="Web Fonts" />
                            <ListViewItem Content="SSL Certificate Check" />
                            <ListViewItem Content="User Agent" />
                            <ListViewItem Content="Compatibility Mode" />
                            <ListViewItem Content="External Apps" />
                            <ListViewItem Content="Picture in Picture" />
                            <ListViewItem Content="Clipboard" />
                            <ListViewItem Content="Device Info" />
                            <ListViewItem Content="Media Key System" />
                            <ListViewItem Content="Pointer Lock" />
                            <ListViewItem Content="Website Data Access" />
                            <ListViewItem
                                Margin="0,12,0,0"
                                Content="Extension Settings"
                                FontWeight="SemiBold"
                                IsEnabled="False" />
                            <ListViewItem Content="Momentum" />
                        </ListView>
                    </Grid>

                    <!--  Website Setting Detail (Right)  -->
                    <Grid Grid.Column="1" Padding="24,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Setting-specific content  -->
                        <Grid Grid.Row="0">
                            <TextBlock
                                x:Name="WebsiteSettingPlaceholder"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Select a setting to configure" />

                            <StackPanel
                                x:Name="WebsiteSettingDetailContent"
                                MaxWidth="480"
                                HorizontalAlignment="Left"
                                Spacing="16"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="WebsiteSettingTitle"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Default settings for all websites:" />
                                    <ComboBox x:Name="WebsiteDefaultComboBox" SelectionChanged="WebsiteDefaultComboBox_SelectionChanged" />
                                </StackPanel>
                                <StackPanel
                                    x:Name="WebsiteCustomUserAgentPanel"
                                    Spacing="4"
                                    Visibility="Collapsed">
                                    <TextBlock Text="Custom user agent string:" />
                                    <TextBox
                                        x:Name="WebsiteCustomUserAgentTextBox"
                                        PlaceholderText="Enter custom user agent string"
                                        TextChanged="WebsiteCustomUserAgent_TextChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!--  Configured Websites  -->
                        <TextBlock
                            x:Name="ConfiguredWebsitesHeader"
                            Grid.Row="1"
                            Margin="0,24,0,8"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Configured Websites"
                            Visibility="Collapsed" />
                        <Grid
                            x:Name="ConfiguredWebsitesPanel"
                            Grid.Row="2"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListView x:Name="ConfiguredWebsitesListView" Grid.Row="0" />
                            <Button
                                Grid.Row="1"
                                Margin="0,4,0,0"
                                Click="AddConfiguredWebsite_Click"
                                Content="+"
                                FontSize="16" />
                        </Grid>
                    </Grid>
                </Grid>

                <!--  Advanced Content  -->
                <ScrollViewer x:Name="AdvancedContent" Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        Spacing="0">
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="Advanced" />

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Row 0: Rendering  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Text="Rendering:" />
                            <CheckBox
                                x:Name="EnableJsonFormattingCheckBox"
                                Grid.Row="0"
                                Grid.Column="1"
                                Checked="EnableJsonFormatting_Changed"
                                Content="Enable JSON formatting"
                                Unchecked="EnableJsonFormatting_Changed" />

                            <!--  Row 1: Separator  -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Height="1"
                                Margin="0,4"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!--  Row 2: Extensions  -->
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Text="Extensions:" />
                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="1"
                                Spacing="4">
                                <CheckBox
                                    x:Name="AllowChromeExtensionsCheckBox"
                                    Checked="AllowChromeExtensions_Changed"
                                    Content="Allow installation of 3rd-party Chrome extensions"
                                    Unchecked="AllowChromeExtensions_Changed" />
                                <CheckBox
                                    x:Name="AllowFirefoxExtensionsCheckBox"
                                    Checked="AllowFirefoxExtensions_Changed"
                                    Content="Allow installation of 3rd-party Firefox extensions"
                                    Unchecked="AllowFirefoxExtensions_Changed" />
                                <Button Content="Manage Extensions..." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!--  Extensions Content  -->
                <ScrollViewer x:Name="ExtensionsContent" Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="600"
                        Padding="0,0,0,32"
                        HorizontalAlignment="Center"
                        Spacing="16">
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="Extensions" />
                        <TextBlock
                            x:Name="NoExtensionsText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No extensions installed."
                            Visibility="Collapsed" />
                        <Button Click="OpenPopularExtensions_Click" Content="Get Popular Extensions..." />
                        <ListView
                            x:Name="InstalledExtensionsList"
                            IsItemClickEnabled="False"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ExtensionEntry">
                                    <Grid Padding="4,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" />
                                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{x:Bind TypeLabel}" />
                                                <Run Text=" · " />
                                                <Run Text="{x:Bind Version, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                            OffContent=""
                                            OnContent=""
                                            Toggled="ExtensionToggle_Toggled" />
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Click="UninstallExtension_Click"
                                            Content="Uninstall"
                                            Tag="{x:Bind Id}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <!--  Plus Content  -->
                <ScrollViewer x:Name="PlusContent" Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        Spacing="0">
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="Orion+" />

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Row 0: Status  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="Status:" />
                            <TextBlock
                                x:Name="PlusStatusText"
                                Grid.Row="0"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="Not subscribed" />

                            <!--  Row 1: Separator  -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Height="1"
                                Margin="0,8"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!--  Row 2: Features  -->
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Text="Features:" />
                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="1"
                                Spacing="8">
                                <TextBlock Text="Orion+ unlocks premium features including advanced content blockers, sync across unlimited devices, and more." TextWrapping="Wrap" />
                                <HyperlinkButton Content="Learn more about Orion+" NavigateUri="https://browser.kagi.com/orionplus.html" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!--  About Content  -->
                <StackPanel
                    x:Name="AboutContent"
                    MaxWidth="600"
                    HorizontalAlignment="Center"
                    Spacing="16"
                    Visibility="Collapsed">
                    <Image
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Left"
                        Source="/Assets/orion-logo.png" />
                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Text="Orion Browser" />
                    <TextBlock x:Name="AboutVersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="A WebKit-based browser for Windows" />
                    <HyperlinkButton Content="Visit Website" NavigateUri="https://orionbrowser.com/" />
                </StackPanel>

                <!--  Profiles Content  -->
                <Grid
                    x:Name="ProfilesContent"
                    MaxWidth="800"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Profile List (Left)  -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,12"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Profiles" />

                        <ListView
                            x:Name="ProfileListView"
                            Grid.Row="1"
                            AllowDrop="True"
                            CanDragItems="True"
                            CanReorderItems="True"
                            DragItemsCompleted="ProfileListView_DragItemsCompleted"
                            SelectionChanged="ProfileListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Profile">
                                    <Grid Padding="4,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Width="28"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe UI Emoji"
                                            FontSize="{x:Bind IconFontSize, Mode=OneWay}"
                                            Foreground="{x:Bind IconForeground, Mode=OneWay}"
                                            HorizontalTextAlignment="Center"
                                            Text="{x:Bind DisplayIcon, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Name, Mode=OneWay}" />
                                        <Border
                                            Grid.Column="2"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            Visibility="{x:Bind IsDefault, Mode=OneWay}">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Text="Default" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Click="AddProfile_Click" Content="Add Profile" />
                            <Button Click="DeleteProfile_Click" Content="Delete" />
                        </StackPanel>
                    </Grid>

                    <!--  Profile Detail (Right)  -->
                    <ScrollViewer Grid.Column="1" Padding="24,0,0,0">
                        <StackPanel
                            x:Name="ProfileDetailPanel"
                            MaxWidth="480"
                            HorizontalAlignment="Left"
                            Spacing="16"
                            Visibility="Collapsed">

                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Profile Settings" />

                            <!--  Name  -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Name" />
                                <TextBox x:Name="ProfileNameTextBox" TextChanged="ProfileName_TextChanged" />
                            </StackPanel>

                            <!--  Browser Engine  -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Browser Engine" />
                                <ComboBox x:Name="BrowserEngineComboBox" SelectionChanged="BrowserEngine_SelectionChanged">
                                    <ComboBoxItem Content="WebKit" Tag="webkit" />
                                    <ComboBoxItem Content="Blink (Chromium)" Tag="blink" />
                                </ComboBox>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Each profile runs in its own process with its own engine. Takes effect the next time this profile's window is opened."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!--  Icon  -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Icon" />
                                <StackPanel
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <GridView
                                        x:Name="ProfileColorGridView"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        SelectionChanged="ProfileColor_SelectionChanged"
                                        SelectionMode="Single">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid MaximumRowsOrColumns="8" Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                    </GridView>
                                    <Button
                                        Padding="6"
                                        VerticalAlignment="Center"
                                        Click="OpenEmojiPicker_Click">
                                        <TextBlock
                                            x:Name="EmojiButtonLabel"
                                            FontFamily="Segoe UI Emoji"
                                            FontSize="16"
                                            Text="🚀" />
                                    </Button>
                                    <TextBox
                                        x:Name="EmojiCaptureTextBox"
                                        Width="0"
                                        Height="0"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Canvas.ZIndex="-1"
                                        GotFocus="EmojiCaptureTextBox_GotFocus"
                                        Opacity="0"
                                        TextChanged="EmojiCapture_TextChanged" />
                                </StackPanel>
                            </StackPanel>

                            <!--  Toggles  -->
                            <ToggleSwitch
                                x:Name="ShowInAddressBarToggle"
                                Header="Show in Address Bar"
                                Toggled="ShowInAddressBar_Toggled" />

                            <ToggleSwitch
                                x:Name="ShowBadgeInAppIconToggle"
                                Header="Show Badge in App Icon"
                                Toggled="ShowBadgeInAppIcon_Toggled" />

                            <!--  Keyboard Shortcut  -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Keyboard Shortcut" />
                                <models:ShortcutRecorderBox x:Name="KeyboardShortcutRecorder" HorizontalAlignment="Left" />
                                <TextBlock
                                    x:Name="KeyboardShortcutError"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Visibility="Collapsed" />
                            </StackPanel>

                            <!--  Set as Default  -->
                            <Button
                                x:Name="SetDefaultButton"
                                Click="SetDefault_Click"
                                Content="Set as Default Profile" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </NavigationView>
    </Grid>
</UserControl>
