<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Orion.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Orion"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView
            x:Name="SettingsNavigationView"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="250"
            PaneDisplayMode="Left"
            PaneTitle="Settings"
            SelectionChanged="SettingsNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="General">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Profiles" Tag="Profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Appearance" Tag="Appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tabs" Tag="Tabs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE737;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Browsing" Tag="Browsing">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Sync" Tag="Sync">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Passwords" Tag="Passwords">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Privacy" Tag="Privacy">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Search" Tag="Search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Websites" Tag="Websites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Advanced" Tag="Advanced">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE15E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Plus" Tag="Plus">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Extensions" Tag="Extensions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!--  Settings Content Area  -->
            <Grid Padding="24">
                <!--  General Content  -->
                <ScrollViewer x:Name="GeneralContent" Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        Spacing="0">
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="General" />

                        <!--  Two-column form grid: labels right-aligned, controls left-aligned  -->
                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Row 0: Orion opens with  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="Orion opens with:" />
                            <ComboBox
                                x:Name="OrionOpensWithComboBox"
                                Grid.Row="0"
                                Grid.Column="1"
                                SelectionChanged="OrionOpensWith_SelectionChanged">
                                <ComboBoxItem Content="A new window" />
                                <ComboBoxItem Content="A new private window" />
                                <ComboBoxItem Content="All windows from last session" />
                                <ComboBoxItem Content="All non-private windows from last session" />
                            </ComboBox>

                            <!--  Row 1: New windows open with  -->
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="New windows open with:" />
                            <ComboBox
                                x:Name="NewWindowsOpenWithComboBox"
                                Grid.Row="1"
                                Grid.Column="1"
                                SelectionChanged="NewWindowsOpenWith_SelectionChanged">
                                <ComboBoxItem Content="Start page" />
                                <ComboBoxItem Content="Empty page" />
                                <ComboBoxItem Content="Same page" />
                                <ComboBoxItem Content="Homepage" />
                                <ComboBoxItem Content="Notes" />
                            </ComboBox>

                            <!--  Row 2: New tabs open with  -->
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="New tabs open with:" />
                            <ComboBox
                                x:Name="NewTabsOpenWithComboBox"
                                Grid.Row="2"
                                Grid.Column="1"
                                SelectionChanged="NewTabsOpenWith_SelectionChanged">
                                <ComboBoxItem Content="Start page" />
                                <ComboBoxItem Content="Empty page" />
                                <ComboBoxItem Content="Same page" />
                                <ComboBoxItem Content="Homepage" />
                                <ComboBoxItem Content="Notes" />
                            </ComboBox>

                            <!--  Row 3: Homepage  -->
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="Homepage:" />
                            <TextBox
                                x:Name="HomepageTextBox"
                                Grid.Row="3"
                                Grid.Column="1"
                                PlaceholderText="https://example.com"
                                TextChanged="Homepage_TextChanged" />

                            <!--  Row 4: File download location  -->
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="File download location:" />
                            <ComboBox
                                x:Name="FileDownloadLocationComboBox"
                                Grid.Row="4"
                                Grid.Column="1"
                                SelectionChanged="FileDownloadLocation_SelectionChanged">
                                <ComboBoxItem Content="Downloads" />
                                <ComboBoxItem Content="Ask for each download" />
                                <ComboBoxItem Content="Other..." />
                            </ComboBox>
                            <TextBlock
                                x:Name="CustomDownloadPathText"
                                Grid.Row="4"
                                Grid.Column="1"
                                Margin="0,36,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="Collapsed" />

                            <!--  Row 5: Remove download items  -->
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="Remove download items:" />
                            <ComboBox
                                x:Name="RemoveDownloadItemsComboBox"
                                Grid.Row="5"
                                Grid.Column="1"
                                SelectionChanged="RemoveDownloadItems_SelectionChanged">
                                <ComboBoxItem Content="After one day" />
                                <ComboBoxItem Content="When Orion quits" />
                                <ComboBoxItem Content="Upon successful download" />
                                <ComboBoxItem Content="Manually" />
                            </ComboBox>

                            <!--  Row 6: Language  -->
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="Language:" />
                            <ComboBox
                                x:Name="LanguageComboBox"
                                Grid.Row="6"
                                Grid.Column="1"
                                SelectionChanged="Language_SelectionChanged">
                                <ComboBoxItem Content="German" />
                                <ComboBoxItem Content="Arabic" />
                                <ComboBoxItem Content="Greek" />
                                <ComboBoxItem Content="Chinese (Simplified)" />
                                <ComboBoxItem Content="Japanese" />
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="Ukrainian" />
                                <ComboBoxItem Content="Spanish" />
                                <ComboBoxItem Content="Slovenian" />
                                <ComboBoxItem Content="Galician" />
                                <ComboBoxItem Content="Italian" />
                                <ComboBoxItem Content="Swedish" />
                                <ComboBoxItem Content="Czech" />
                                <ComboBoxItem Content="Chinese (Traditional)" />
                                <ComboBoxItem Content="Turkish" />
                                <ComboBoxItem Content="Polish" />
                                <ComboBoxItem Content="Portuguese (Brazil)" />
                                <ComboBoxItem Content="Russian" />
                                <ComboBoxItem Content="French" />
                                <ComboBoxItem Content="Finnish" />
                                <ComboBoxItem Content="Dutch" />
                                <ComboBoxItem Content="Polish (Poland)" />
                            </ComboBox>

                            <!--  Row 7: Open external links in  -->
                            <TextBlock
                                Grid.Row="7"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="Open external links in:" />
                            <ComboBox
                                x:Name="OpenExternalLinksComboBox"
                                Grid.Row="7"
                                Grid.Column="1"
                                SelectionChanged="OpenExternalLinksIn_SelectionChanged">
                                <ComboBoxItem Content="Last active profile" />
                                <ComboBoxItem Content="Default profile" />
                            </ComboBox>

                            <!--  Row 8: Separator  -->
                            <Border
                                Grid.Row="8"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Height="1"
                                Margin="0,8"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!--  Row 9: Import browser data  -->
                            <TextBlock
                                Grid.Row="9"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="Import browser data:" />
                            <Button
                                x:Name="ImportBrowserDataButton"
                                Grid.Row="9"
                                Grid.Column="1"
                                Content="Import..." />

                            <!--  Row 10: Orion updates  -->
                            <TextBlock
                                Grid.Row="10"
                                Grid.Column="0"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Text="Orion updates:" />
                            <StackPanel Grid.Row="10" Grid.Column="1">
                                <CheckBox
                                    x:Name="AutoUpdateCheckBox"
                                    Checked="AutoUpdate_Changed"
                                    Content="Automatically keep Orion up to date"
                                    Unchecked="AutoUpdate_Changed" />
                                <CheckBox
                                    x:Name="ShowWarningBeforeQuittingCheckBox"
                                    Checked="ShowWarningBeforeQuitting_Changed"
                                    Content="Show warning before quitting"
                                    Unchecked="ShowWarningBeforeQuitting_Changed" />
                            </StackPanel>

                            <!--  Row 11: Separator  -->
                            <Border
                                Grid.Row="11"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Height="1"
                                Margin="0,8"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!--  Row 12: Default browser status  -->
                            <TextBlock
                                Grid.Row="12"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="Default browser:" />
                            <StackPanel
                                Grid.Row="12"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock
                                    x:Name="DefaultBrowserText"
                                    VerticalAlignment="Center"
                                    Text="Orion is not your default browser." />
                                <Button
                                    x:Name="SetDefaultBrowserButton"
                                    Click="SetDefaultBrowser_Click"
                                    Content="Set Default..." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!--  Appearance Content  -->
                <ScrollViewer x:Name="AppearanceContent" Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        Spacing="0">
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="Appearance" />

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Row 0: Theme  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="Theme:" />
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ComboBox x:Name="ThemeComboBox" SelectionChanged="Theme_SelectionChanged">
                                    <ComboBoxItem Content="System default" />
                                    <ComboBoxItem Content="Light" />
                                    <ComboBoxItem Content="Dark" />
                                </ComboBox>
                                <Button VerticalAlignment="Center" Content="Customize..." />
                            </StackPanel>

                            <!--  Row 1: Show website color (no label)  -->
                            <CheckBox
                                x:Name="ShowWebsiteColorCheckBox"
                                Grid.Row="1"
                                Grid.Column="1"
                                Checked="ShowWebsiteColor_Changed"
                                Content="Show website color for vertical tabs"
                                Unchecked="ShowWebsiteColor_Changed" />

                            <!--  Row 2: Separator  -->
                            <Border
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Height="1"
                                Margin="0,4"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!--  Row 3: Toolbar  -->
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Text="Toolbar:" />
                            <StackPanel Grid.Row="3" Grid.Column="1">
                                <CheckBox
                                    x:Name="AlwaysShowToolbarCheckBox"
                                    Checked="AlwaysShowToolbar_Changed"
                                    Content="Always show toolbar in full screen"
                                    Unchecked="AlwaysShowToolbar_Changed" />
                                <CheckBox
                                    x:Name="ShowBookmarksBarCheckBox"
                                    Checked="ShowBookmarksBar_Changed"
                                    Content="Show bookmarks bar"
                                    Unchecked="ShowBookmarksBar_Changed" />

                                <CheckBox
                                    x:Name="DisplayRssFeedsCheckBox"
                                    Checked="DisplayRssFeeds_Changed"
                                    Content="Display RSS Feeds indicator"
                                    Unchecked="DisplayRssFeeds_Changed" />
                                <CheckBox
                                    x:Name="DisplayWebAppCheckBox"
                                    Checked="DisplayWebApp_Changed"
                                    Content="Display Web Application indicator"
                                    Unchecked="DisplayWebApp_Changed" />
                            </StackPanel>

                            <!--  Row 4: Bookmarks bar  -->
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="Bookmarks bar:" />
                            <ComboBox
                                x:Name="BookmarksBarComboBox"
                                Grid.Row="4"
                                Grid.Column="1"
                                SelectionChanged="BookmarksBarStyle_SelectionChanged">
                                <ComboBoxItem Content="Text only" />
                                <ComboBoxItem Content="Icon and text" />
                                <ComboBoxItem Content="Icon only" />
                            </ComboBox>

                            <!--  Row 5: Sidebar  -->
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Text="Sidebar:" />
                            <CheckBox
                                x:Name="AutoShowSidebarCheckBox"
                                Grid.Row="5"
                                Grid.Column="1"
                                Checked="AutoShowSidebar_Changed"
                                Content="Auto-show sidebar in full screen"
                                Unchecked="AutoShowSidebar_Changed" />

                            <!--  Row 6: Default font  -->
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="Default font:" />
                            <StackPanel
                                Grid.Row="6"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ComboBox x:Name="DefaultFontComboBox" SelectionChanged="DefaultFontFamily_SelectionChanged">
                                    <ComboBoxItem Content="Segoe UI" />
                                    <ComboBoxItem Content="Arial" />
                                    <ComboBoxItem Content="Times New Roman" />
                                    <ComboBoxItem Content="Consolas" />
                                </ComboBox>
                                <Button VerticalAlignment="Center" Content="Customize..." />
                            </StackPanel>

                            <!--  Row 7: Rendering  -->
                            <TextBlock
                                Grid.Row="7"
                                Grid.Column="0"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Text="Rendering:" />
                            <StackPanel Grid.Row="7" Grid.Column="1">
                                <CheckBox
                                    x:Name="Prefer120FpsCheckBox"
                                    Checked="Prefer120Fps_Changed"
                                    Content="Prefer page rendering updates near 120fps"
                                    Unchecked="Prefer120Fps_Changed" />
                                <CheckBox
                                    x:Name="DisableTransparencyCheckBox"
                                    Checked="DisableTransparency_Changed"
                                    Content="Disable transparency for full screen windows"
                                    Unchecked="DisableTransparency_Changed" />
                            </StackPanel>

                            <!--  Row 8: App icon  -->
                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="0"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Text="App icon:" />
                            <GridView
                                x:Name="AppIconGridView"
                                Grid.Row="8"
                                Grid.Column="1"
                                SelectionMode="Single">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid MaximumRowsOrColumns="6" Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridViewItem IsSelected="True">
                                    <Image
                                        Width="48"
                                        Height="48"
                                        Source="/Assets/orion-logo.png" />
                                </GridViewItem>
                                <GridViewItem>
                                    <Image
                                        Width="48"
                                        Height="48"
                                        Source="/Assets/orion-logo.png" />
                                </GridViewItem>
                                <GridViewItem>
                                    <Image
                                        Width="48"
                                        Height="48"
                                        Source="/Assets/orion-logo.png" />
                                </GridViewItem>
                            </GridView>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!--  Tabs Content  -->
                <ScrollViewer x:Name="TabsContent" Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        Spacing="0">
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="Tabs" />

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Row 0: Tab layout  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="Tab layout:" />
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                                <RadioButton
                                    x:Name="StandardTabLayoutRadio"
                                    Checked="TabLayout_Changed"
                                    GroupName="TabLayout"
                                    IsChecked="True">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE89A;" />
                                        <TextBlock Text="Standard" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="CompactTabLayoutRadio"
                                    Checked="TabLayout_Changed"
                                    GroupName="TabLayout">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE737;" />
                                        <TextBlock Text="Compact" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="VerticalTabLayoutRadio"
                                    Checked="TabLayout_Changed"
                                    GroupName="TabLayout">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE71D;" />
                                        <TextBlock Text="Vertical" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <!--  Row 1: Tab appearance checkboxes (no label)  -->
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <CheckBox
                                    x:Name="UseMiniToolbarCheckBox"
                                    Checked="UseMiniToolbar_Changed"
                                    Content="Use Mini Toolbar"
                                    Unchecked="UseMiniToolbar_Changed" />
                                <CheckBox
                                    x:Name="ShowTabPreviewCheckBox"
                                    Checked="ShowTabPreview_Changed"
                                    Content="Show tab preview on hover"
                                    Unchecked="ShowTabPreview_Changed" />
                                <CheckBox
                                    x:Name="AlwaysShowWebsiteTitlesCheckBox"
                                    Checked="AlwaysShowWebsiteTitles_Changed"
                                    Content="Always show website titles in tabs"
                                    Unchecked="AlwaysShowWebsiteTitles_Changed" />
                                <CheckBox
                                    x:Name="ShowFaviconsInTabsCheckBox"
                                    Checked="ShowFaviconsInTabs_Changed"
                                    Content="Show favicons inside tabs"
                                    Unchecked="ShowFaviconsInTabs_Changed" />
                            </StackPanel>

                            <!--  Row 2: Close window with last tab (no label)  -->
                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="1"
                                Spacing="0">
                                <CheckBox
                                    x:Name="CloseWindowWithLastTabCheckBox"
                                    Checked="CloseWindowWithLastTab_Changed"
                                    Content="Close window with last tab"
                                    Unchecked="CloseWindowWithLastTab_Changed" />
                                <CheckBox
                                    x:Name="WhenPinnedTabsPresentCheckBox"
                                    Margin="28,0,0,0"
                                    Checked="WhenPinnedTabsPresent_Changed"
                                    Content="When pinned tabs are present"
                                    Unchecked="WhenPinnedTabsPresent_Changed" />
                            </StackPanel>

                            <!--  Row 3: Separator  -->
                            <Border
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Height="1"
                                Margin="0,4"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!--  Row 4: Navigation  -->
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Text="Navigation:" />
                            <StackPanel Grid.Row="4" Grid.Column="1">
                                <CheckBox
                                    x:Name="OpenNewTabNextToCurrentCheckBox"
                                    Checked="OpenNewTabNextToCurrent_Changed"
                                    Content="Open new tab next to current tab"
                                    Unchecked="OpenNewTabNextToCurrent_Changed" />
                                <CheckBox
                                    x:Name="MakeNewTabActiveCheckBox"
                                    Checked="MakeNewTabActive_Changed"
                                    Content="When opening a link in a new tab, make it active"
                                    Unchecked="MakeNewTabActive_Changed" />
                                <CheckBox
                                    x:Name="AutoActivatePinnedTabsCheckBox"
                                    Checked="AutoActivatePinnedTabs_Changed"
                                    Content="Automatically activate pinned tabs on loading"
                                    Unchecked="AutoActivatePinnedTabs_Changed" />
                                <CheckBox
                                    x:Name="ReturnToLastActiveTabCheckBox"
                                    Checked="ReturnToLastActiveTab_Changed"
                                    Content="Return to last active tab when closing current tab"
                                    Unchecked="ReturnToLastActiveTab_Changed" />
                                <CheckBox
                                    x:Name="PreventClosingPinnedTabsCheckBox"
                                    Checked="PreventClosingPinnedTabs_Changed"
                                    Content="Prevent closing pinned tabs"
                                    Unchecked="PreventClosingPinnedTabs_Changed" />
                                <CheckBox
