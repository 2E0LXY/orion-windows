<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Orion.ResetWindowContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="32"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                Text="Reset Orion" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,16,24,0">
            <StackPanel Spacing="16">

                <!--  Header  -->
                <StackPanel Spacing="4">
                    <Image
                        Width="48"
                        Height="48"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        Source="ms-appx:///Assets/orion-logo.png" />
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Are you sure you want to reset Orion?"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Select the items you want to reset, then click Reset. You cannot undo this operation."
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Browsing data  -->
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Browsing data" />
                    <CheckBox
                        x:Name="ClearHistoryCheck"
                        Content="Clear history"
                        IsChecked="True" />
                    <CheckBox
                        x:Name="RemoveBookmarksCheck"
                        Content="Remove all bookmarks"
                        IsChecked="True" />
                    <CheckBox
                        x:Name="RemoveReadingListCheck"
                        Content="Remove the reading list"
                        IsChecked="True" />
                    <CheckBox
                        x:Name="RemoveSnapshotsCheck"
                        Content="Remove all snapshots"
                        IsChecked="True" />
                    <CheckBox
                        x:Name="RemoveDownloadsCheck"
                        Content="Remove all downloads"
                        IsChecked="True" />

                    <StackPanel
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="Older than:" />
                        <ComboBox
                            x:Name="OlderThanCombo"
                            MinWidth="140"
                            SelectedIndex="2">
                            <ComboBoxItem Content="One Day" />
                            <ComboBoxItem Content="One Week" />
                            <ComboBoxItem Content="One Month" />
                            <ComboBoxItem Content="One Year" />
                            <ComboBoxItem Content="All Time" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!--  Resources  -->
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Resources" />
                    <CheckBox
                        x:Name="ResetSettingsCheck"
                        Content="Reset all settings (Relaunch to Take Effect)"
                        IsChecked="True" />
                    <CheckBox
                        x:Name="ResetWebsiteSettingsCheck"
                        Content="Reset all website settings"
                        IsChecked="True" />
                    <CheckBox
                        x:Name="RemoveCookiesCheck"
                        Content="Remove all cookies"
                        IsChecked="True" />
                    <CheckBox
                        x:Name="EmptyCacheCheck"
                        Content="Empty the browser cache"
                        IsChecked="True" />
                    <CheckBox
                        x:Name="EmptyStorageCheck"
                        Content="Empty local storage and databases"
                        IsChecked="True" />
                    <CheckBox
                        x:Name="RemovePasswordsCheck"
                        Content="Remove saved passwords"
                        IsChecked="True" />
                    <CheckBox
                        x:Name="RemoveExtensionsCheck"
                        Content="Remove all extensions"
                        IsChecked="True" />
                    <CheckBox
                        x:Name="RemovePageTweaksCheck"
                        Content="Remove all page tweaks"
                        IsChecked="True" />
                    <CheckBox
                        x:Name="CloseWindowsCheck"
                        Content="Close all windows"
                        IsChecked="True" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!--  Buttons  -->
        <Grid Grid.Row="2" Padding="24,12,24,16">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="CancelButton"
                    MinWidth="100"
                    Click="CancelButton_Click"
                    Content="Cancel"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="ResetButton"
                    MinWidth="100"
                    Click="ResetButton_Click"
                    Content="Reset" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
